{
  "rules": {
    "presence": {
      "castle-8cb15": {
        "users": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['status', 'lastSeen', 'cellId'])"
          }
        }
      }
    }
  }
}
