{
  "name": "castle-genesis-gate",
  "version": "1.0.0",
  "description": "Castle Genesis Firebase realtime causal dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "lint:functions": "npm --prefix functions run lint",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && firebase deploy --only hosting,functions --project castle-genesis",
    "deploy:ci": "./ci_deploy.sh"
  },
  "dependencies": {
    "firebase": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "firebase-tools": "latest",
    "tailwindcss": "latest",
    "vite": "latest"
  }
}
